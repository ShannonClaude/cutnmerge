# 复制为 .env 后填写。勿将含真实 Token 的 .env 提交到版本库。

# ---------- 必填 ----------
# 百度 AI Studio Access Token（PaddleOCR 云端 API）
# 获取：https://aistudio.baidu.com/account/accessToken
PADDLEOCR_ACCESS_TOKEN=Your_Token

# ---------- 可选：API 与模型 ----------
# 自定义 API Base URL；留空则使用官方默认端点
# PADDLEOCR_BASE_URL=

# 任务类型：ocr（推荐，细粒度文本框，供 IoA 填格）| doc_parsing（PaddleOCR-VL 版面解析）
PADDLEOCR_TASK=ocr

# ocr 任务使用的模型
PADDLEOCR_OCR_MODEL=PP-OCRv6

# doc_parsing 任务使用的模型
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6

# ---------- 可选：超时（秒） ----------
PADDLEOCR_REQUEST_TIMEOUT=300
PADDLEOCR_POLL_TIMEOUT=600

# ---------- 可选：模块开关（true/false） ----------
PADDLEOCR_USE_LAYOUT_DETECTION=true
# 图像方向校正
PADDLEOCR_USE_DOC_ORIENTATION_CLASSIFY=false
# 图像畸变校正
PADDLEOCR_USE_DOC_UNWARPING=false
# 文本行方向校正
PADDLEOCR_USE_TEXTLINE_ORIENTATION=false
PADDLEOCR_USE_CHART_RECOGNITION=false
PADDLEOCR_PRETTIFY_MARKDOWN=false

# ---------- 可选：OCR 解析配置（PP-OCRv6） ----------
# 图片边长限制类型：min=短边不少于 N / max=长边不超过 N
# 注意：min+过大 N 会把小图强行放大，云端易 500；当前图短边~700，勿用 min+2070
# 与 source 对齐：min=短边不少于 N（该图短边~800，不会被强行放大到 2070）
PADDLEOCR_TEXT_DET_LIMIT_TYPE=min
# 图片边长限制
PADDLEOCR_TEXT_DET_LIMIT_SIDE_LEN=2070
# 文本检测像素阈值
PADDLEOCR_TEXT_DET_THRESH=0.55
# 文本检测框阈值
PADDLEOCR_TEXT_DET_BOX_THRESH=0.75
# 膨胀系数
PADDLEOCR_TEXT_DET_UNCLIP_RATIO=1.2
# 文本识别得分阈值
PADDLEOCR_TEXT_REC_SCORE_THRESH=0.60

# ---------- 可选：表格管线 ----------
# 可疑单元格二次 OCR（费时/耗 API）；默认 false
REOCR=false
REOCR_MAX_CELLS=24
# 激进结构后处理（补列/重建表头/横切表头）；默认 false，信任 TableStructureRec
TSR_AGGRESSIVE=false
