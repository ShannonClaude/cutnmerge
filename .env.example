# 复制为 .env 后填写。勿将含真实 Token 的 .env 提交到版本库。

# ---------- 必填 ----------
# 百度 AI Studio Access Token（PaddleOCR 云端 API）
# 获取：https://aistudio.baidu.com/account/accessToken
PADDLEOCR_ACCESS_TOKEN=your-access-token-here

# ---------- 可选：API 与模型 ----------
# 自定义 API Base URL；留空则使用官方默认端点
# PADDLEOCR_BASE_URL=

# 任务类型：ocr（推荐，细粒度文本框，供 IoA 填格）| doc_parsing（PaddleOCR-VL 版面解析）
PADDLEOCR_TASK=ocr

# ocr 任务使用的模型
PADDLEOCR_OCR_MODEL=PP-OCRv6

# doc_parsing 任务使用的模型
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6

# ---------- 可选：超时（秒） ----------
PADDLEOCR_REQUEST_TIMEOUT=300
PADDLEOCR_POLL_TIMEOUT=600

# ---------- 可选：doc_parsing 相关开关（true/false） ----------
PADDLEOCR_USE_LAYOUT_DETECTION=true
PADDLEOCR_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLEOCR_USE_DOC_UNWARPING=false
PADDLEOCR_USE_CHART_RECOGNITION=false
PADDLEOCR_PRETTIFY_MARKDOWN=false
